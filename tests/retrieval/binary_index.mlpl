include "../../src/retrieval/binary_index.mlpl"
def u:check_binary(c,l){if c{1}else{eprint("FAIL",l);exit(1)}}
u:check_binary(eq(u:hamming(10,15),2),"Hamming distance")
codes=[0,1,2,3,60,61,62,63];queries=[4,5,58,59]
r=u:evaluate_prefix(codes,queries,2)
u:check_binary(eq(r.recall,1),"shortlist preserves nearest neighbor")
u:check_binary(eq(r.exhaustive_comparisons,32),"exhaustive work")
u:check_binary(eq(r.shortlist_comparisons,8),"shortlist work")
u:check_binary(eq(r.fallbacks,0),"no fallback")
u:check_binary(eq(r.reduction,0.75),"comparison reduction")
fallback=u:nearest_prefix([0,4],3,2)
u:check_binary(eq(fallback.fallback,1),"empty bucket falls back")
"PASS binary_index"
