include "../../src/retrieval/recency_monitor.mlpl"
def u:check_recent(c,l){if c{1}else{eprint("FAIL",l);exit(1)}}
stream=[[0,10],[1,11],[2,12],[3,13],[4,14],[5,15]];r=u:recent_rows(stream,6,2)
u:check_recent(eq(reduce_add(eq(shape(r),[2,2]),0),2),"recent shape")
u:check_recent(eq(take(take(r,0,0),0,0),4),"recent first row")
u:check_recent(eq(take(take(r,0,1),0,0),5),"recent last row")
"PASS recency_monitor"
