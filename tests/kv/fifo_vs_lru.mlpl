include "../../src/kv/lru_memory.mlpl"
include "../../src/kv/fifo_memory.mlpl"
include "../../src/bench/eviction_policy_matrix.mlpl"

def u:check_policy(condition, label) { "Exit unsuccessfully when a policy invariant is false."; if condition { 1 } else { eprint("FAIL", label); exit(1) } }

fifo = u:fifo_trace(2, [1, 2, 1, 3])
u:check_policy(u:fifo_valid(fifo.memory), "FIFO memory invariant")
u:check_policy(eq(fifo.hits, 1), "FIFO hit count")
u:check_policy(eq(fifo.evictions, 1), "FIFO eviction count")
u:check_policy(eq(u:fifo_find_from(fifo.memory, 1, 0), -1), "FIFO evicts first loaded despite reuse")

matrix = u:standard_eviction_matrix()
u:check_policy(eq(take(shape(matrix), 0, 0), 8), "four paired workloads")
u:check_policy(eq(take(shape(matrix), 0, 1), 11), "policy schema width")

# Uniform rows 0/1: fitting working sets make policy irrelevant.
u:check_policy(eq(take(take(matrix, 0, 0), 0, 6), take(take(matrix, 0, 1), 0, 6)), "uniform hits match")
u:check_policy(eq(take(take(matrix, 0, 0), 0, 9), take(take(matrix, 0, 1), 0, 9)), "uniform evictions match")

# Hot-set rows 2/3: LRU retains reused keys while FIFO ignores hits.
lru_hot_hits = take(take(matrix, 0, 2), 0, 6)
fifo_hot_hits = take(take(matrix, 0, 3), 0, 6)
u:check_policy(gt(lru_hot_hits, fifo_hot_hits), "LRU improves hot-set hits")
u:check_policy(lt(take(take(matrix, 0, 2), 0, 9), take(take(matrix, 0, 3), 0, 9)), "LRU reduces hot-set evictions")
"PASS fifo_vs_lru"
