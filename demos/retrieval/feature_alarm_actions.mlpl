include "../../src/retrieval/binary_index.mlpl"
include "../../src/retrieval/multiprobe_index.mlpl"
include "../../src/retrieval/feature_alarm_actions.mlpl"
include "../../src/retrieval/reservoir_monitor.mlpl"
initial=[[2,0,0,0],[1.8,0.2,0,0],[-2,0,0,0],[-1.8,-0.2,0,0],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];iq=[[1.9,0.1,0,0],[-1.9,-0.1,0,0],[0.1,1.9,0,0],[-0.1,-1.9,0,0]]
shifted=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,0,0,2],[0,0,0.2,1.8],[0,0,0,-2],[0,0,-0.2,-1.8]];sq=[[0,0,1.9,0.1],[0,0,-1.9,-0.1],[0,0,0.1,1.9],[0,0,-0.1,-1.9]]
retrieval=u:covariance_projection(initial,4);subspace=u:covariance_projection(initial,2);a=initial*0.33+shifted*0.67;aq=iq*0.33+sq*0.67;rotation=concat(initial,a,0)
harmless=iq+matmul(ones([4,1]),[[0,0,1,0]])
local_memory=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];local=[[0,0,1.9,0.1],[0,0,1.7,0.25],[0,0,-1.9,-0.1],[0,0,-1.7,-0.25]]
ri=u:immediate_feature_action(rotation,u:rows_at(aq,[0,1]),aq,retrieval,subspace,4,1,0.1);rc=u:confirmed_feature_action(rotation,u:rows_at(aq,[0,1]),aq,retrieval,subspace,4,1,0.1,0.75)
hi=u:immediate_feature_action(initial,u:rows_at(harmless,[0,1]),harmless,retrieval,subspace,4,1,0.1);hc=u:confirmed_feature_action(initial,u:rows_at(harmless,[0,1]),harmless,retrieval,subspace,4,1,0.1,0.75)
li=u:immediate_feature_action(local_memory,u:rows_at(local,[0,1]),local,retrieval,subspace,4,1,0.1);lc=u:confirmed_feature_action(local_memory,u:rows_at(local,[0,1]),local,retrieval,subspace,4,1,0.1,0.75)
def u:action_row(shape,policy,x) { [1,shape,policy,x.alarm,x.early_recall,x.rebuilt,x.delay,x.rebuild_cells,x.post_recall] }
print("schema shape policy alarm early_recall rebuilt delay rebuild_cells post_recall")
print(u:action_row(1,1,ri));print(u:action_row(1,2,rc));print(u:action_row(2,1,hi));print(u:action_row(2,2,hc));print(u:action_row(3,1,li));u:action_row(3,2,lc)
