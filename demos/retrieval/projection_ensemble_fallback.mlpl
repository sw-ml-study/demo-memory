include "../../src/retrieval/multiprobe_index.mlpl"
include "../../src/retrieval/sign_projection.mlpl"
include "../../src/retrieval/projection_ensemble.mlpl"
memory=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];queries=[[0,0,1.9,0.1],[0,0,1.7,0.25],[0,0,-1.9,-0.1],[0,0,-1.7,-0.25]]
p11=randn(11,[4,8]);p17=randn(17,[4,8]);p29=randn(29,[4,8]);p47=randn(47,[4,8]);p83=randn(83,[4,8])
a=u:evaluate_projection_ensemble3(memory,queries,p11,p17,p29,8,1);b=u:evaluate_projection_ensemble3(memory,queries,p17,p29,p47,8,1);c=u:evaluate_projection_ensemble3(memory,queries,p29,p47,p83,8,1)
def u:ensemble_row(group,x) { [1,group,x.queries,x.agreement_rate,x.agreed_recall,x.fallback_queries,x.final_recall,x.index_work,x.fallback_work,x.total_work] }
print("schema group queries agreement_rate agreed_recall fallback_queries final_recall index_work fallback_work total_work")
