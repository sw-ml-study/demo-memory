include "../../src/retrieval/multiprobe_index.mlpl"
include "../../src/retrieval/sign_projection.mlpl"
include "../../src/retrieval/projection_ensemble.mlpl"
include "../../src/retrieval/budgeted_retrieval.mlpl"
include "../../src/retrieval/fair_budget.mlpl"
initial=[[2,0,0,0],[1.8,0.2,0,0],[-2,0,0,0],[-1.8,-0.2,0,0],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];iq=[[1.9,0.1,0,0],[-1.9,-0.1,0,0],[0.1,1.9,0,0],[-0.1,-1.9,0,0]];shifted=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,0,0,2],[0,0,0.2,1.8],[0,0,0,-2],[0,0,-0.2,-1.8]];sq=[[0,0,1.9,0.1],[0,0,-1.9,-0.1],[0,0,0.1,1.9],[0,0,-0.1,-1.9]];a=initial*0.33+shifted*0.67;queries=iq*0.33+sq*0.67;memory=concat(initial,a,0);p11=randn(11,[4,8]);p17=randn(17,[4,8]);p29=randn(29,[4,8]);p83=randn(83,[4,8])
sg=u:evaluate_budgeted_single(memory,queries,p83,8,1,8);se=u:evaluate_fair_single(memory,queries,p83,8,1,8,0);sr=u:evaluate_fair_single(memory,queries,p83,8,1,8,1);eg=u:evaluate_budgeted_ensemble3(memory,queries,p11,p17,p29,8,1,24);ee=u:evaluate_fair_ensemble3(memory,queries,p11,p17,p29,8,1,24,0);er=u:evaluate_fair_ensemble3(memory,queries,p11,p17,p29,8,1,24,1)
def u:schedule_row(mode,schedule,budget,x){[1,mode,schedule,budget,x.recall,x.comparisons,x.exhausted_queries,x.completed_projections,x.unanimous_queries]}
print("schema mode schedule budget recall comparisons exhausted_queries completed_projections unanimous_queries")
print(u:schedule_row(1,1,8,sg));print(u:schedule_row(1,2,8,se));print(u:schedule_row(1,3,8,sr));print(u:schedule_row(2,1,24,eg));print(u:schedule_row(2,2,24,ee));u:schedule_row(2,3,24,er)
