initial=[[2,0,0,0],[1.8,0.2,0,0],[-2,0,0,0],[-1.8,-0.2,0,0],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];iq=[[1.9,0.1,0,0],[-1.9,-0.1,0,0],[0.1,1.9,0,0],[-0.1,-1.9,0,0]]
shifted=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,0,0,2],[0,0,0.2,1.8],[0,0,0,-2],[0,0,-0.2,-1.8]];sq=[[0,0,1.9,0.1],[0,0,-1.9,-0.1],[0,0,0.1,1.9],[0,0,-0.1,-1.9]]
a=initial*0.33+shifted*0.67;aq=iq*0.33+sq*0.67;memory=concat(initial,a,0);stream=concat(iq,aq,0);base=u:covariance_projection(initial,4);threshold=0.75
def u:monitor(stream,memory,base,count,size,seed,threshold) { sample=u:reservoir_sample(stream,count,size,seed);evaluation=u:rows_at(stream,range(count));u:adaptive_projection_sampled_step(memory,sample.rows,evaluation,base,4,1,threshold) }
a14=u:monitor(stream,memory,base,4,1,17,threshold);a16=u:monitor(stream,memory,base,6,1,17,threshold);a18=u:monitor(stream,memory,base,8,1,17,threshold)
a24=u:monitor(stream,memory,base,4,2,17,threshold);a26=u:monitor(stream,memory,base,6,2,17,threshold);a28=u:monitor(stream,memory,base,8,2,17,threshold)
a44=u:monitor(stream,memory,base,4,4,17,threshold);a46=u:monitor(stream,memory,base,6,4,17,threshold);a48=u:monitor(stream,memory,base,8,4,17,threshold)
print("schema reservoir checkpoint shifted_seen sample_recall triggered post_recall monitored rebuild_cells")
