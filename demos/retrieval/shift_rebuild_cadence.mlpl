include "../../src/retrieval/binary_index.mlpl"
include "../../src/retrieval/multiprobe_index.mlpl"
include "../../src/retrieval/distribution_shift.mlpl"
initial=[[2,0,0,0],[1.8,0.2,0,0],[-2,0,0,0],[-1.8,-0.2,0,0],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];initial_queries=[[1.9,0.1,0,0],[-1.9,-0.1,0,0],[0.1,1.9,0,0],[-0.1,-1.9,0,0]]
shifted=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,0,0,2],[0,0,0.2,1.8],[0,0,0,-2],[0,0,-0.2,-1.8]];shifted_queries=[[0,0,1.9,0.1],[0,0,-1.9,-0.1],[0,0,0.1,1.9],[0,0,-0.1,-1.9]]
a1=initial*0.67+shifted*0.33;q1=initial_queries*0.67+shifted_queries*0.33;a2=initial*0.33+shifted*0.67;q2=initial_queries*0.33+shifted_queries*0.67
width=4;radius=1;base=u:covariance_projection(initial,width);m1=concat(initial,a1,0);m2=concat(initial,a2,0);m3=concat(initial,shifted,0)
n1=u:evaluate_projection_model(m1,q1,base,width,radius);e1m=u:covariance_projection(m1,width);e1=u:evaluate_projection_model(m1,q1,e1m,width,radius);w1=u:projection_rebuild_work(m1,width)
n2=u:evaluate_projection_model(m2,q2,base,width,radius);c2m=u:covariance_projection(m2,width);c2=u:evaluate_projection_model(m2,q2,c2m,width,radius);e2=c2;w2=u:projection_rebuild_work(m2,width)
n3=u:evaluate_projection_model(m3,shifted_queries,base,width,radius);c3=u:evaluate_projection_model(m3,shifted_queries,c2m,width,radius);e3m=u:covariance_projection(m3,width);e3=u:evaluate_projection_model(m3,shifted_queries,e3m,width,radius);w3=u:projection_rebuild_work(m3,width)
print("schema batch severity never_recall cadence2_recall every_recall never_indexed cadence2_indexed every_indexed cadence2_cells every_cells")
[[1,0.33,n1.hamming_recall,n1.hamming_recall,e1.hamming_recall,n1.indexed_recall,n1.indexed_recall,e1.indexed_recall,0,w1.cells],[2,0.67,n2.hamming_recall,c2.hamming_recall,e2.hamming_recall,n2.indexed_recall,c2.indexed_recall,e2.indexed_recall,w2.cells,w1.cells+w2.cells],[3,1,n3.hamming_recall,c3.hamming_recall,e3.hamming_recall,n3.indexed_recall,c3.indexed_recall,e3.indexed_recall,w2.cells,w1.cells+w2.cells+w3.cells]]
