include "../../src/retrieval/binary_index.mlpl"
include "../../src/retrieval/multiprobe_index.mlpl"
include "../../src/retrieval/sign_projection.mlpl"
include "../../src/retrieval/projection_ensemble.mlpl"
include "../../src/retrieval/budgeted_retrieval.mlpl"
initial=[[2,0,0,0],[1.8,0.2,0,0],[-2,0,0,0],[-1.8,-0.2,0,0],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];iq=[[1.9,0.1,0,0],[-1.9,-0.1,0,0],[0.1,1.9,0,0],[-0.1,-1.9,0,0]];shifted=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,0,0,2],[0,0,0.2,1.8],[0,0,0,-2],[0,0,-0.2,-1.8]];sq=[[0,0,1.9,0.1],[0,0,-1.9,-0.1],[0,0,0.1,1.9],[0,0,-0.1,-1.9]]
local_memory=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];local_queries=[[0,0,1.9,0.1],[0,0,1.7,0.25],[0,0,-1.9,-0.1],[0,0,-1.7,-0.25]];a=initial*0.33+shifted*0.67;aq=iq*0.33+sq*0.67;rotation=concat(initial,a,0);scaled=iq*1.25;p11=randn(11,[4,8]);p17=randn(17,[4,8]);p29=randn(29,[4,8]);p83=randn(83,[4,8])
def u:single(v,q,budget){u:evaluate_budgeted_single(v,q,p83,8,1,budget)};def u:ensemble(v,q,budget){u:evaluate_budgeted_ensemble3(v,q,p11,p17,p29,8,1,budget)}
ls8=u:single(local_memory,local_queries,8);le24=u:ensemble(local_memory,local_queries,24);rs8=u:single(rotation,aq,8);re24=u:ensemble(rotation,aq,24);ss8=u:single(initial,scaled,8);se24=u:ensemble(initial,scaled,24)
def u:hard_row(workload,mode,budget,x){[1,workload,mode,budget,x.recall,x.comparisons,x.exhausted_queries,x.completed_projections,if eq(mode,2){x.unanimous_queries}else{0},if eq(mode,2){x.dense_fallbacks}else{0}]}
print("schema workload mode total_budget recall total_comparisons exhausted_queries completed_projections unanimous_queries dense_fallbacks")
print(u:hard_row(1,1,8,ls8));print(u:hard_row(1,2,24,le24));print(u:hard_row(2,1,8,rs8));print(u:hard_row(2,2,24,re24));print(u:hard_row(3,1,8,ss8));u:hard_row(3,2,24,se24)
