p11=randn(11,[4,8]);p17=randn(17,[4,8]);p29=randn(29,[4,8]);p83=randn(83,[4,8]);one=u:evaluate_projected(memory,queries,p83,8,1);three=u:evaluate_projection_ensemble3(memory,queries,p11,p17,p29,8,1);exact=u:dense_fallback_summary(memory,queries)
single=u:budget_candidate(1,one.indexed_recall,one.indexed_comparisons);ensemble=u:budget_candidate(2,three.final_recall,three.total_work);dense=u:budget_candidate(3,exact.recall,exact.comparisons)
a=u:select_retrieval_budget(8,single,ensemble,dense);b=u:select_retrieval_budget(16,single,ensemble,dense);c=u:select_retrieval_budget(24,single,ensemble,dense);d=u:select_retrieval_budget(32,single,ensemble,dense)
