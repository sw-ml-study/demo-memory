include "../../src/retrieval/binary_index.mlpl"
include "../../src/retrieval/multiprobe_index.mlpl"
include "../../src/retrieval/sign_projection.mlpl"
include "../../src/retrieval/projection_ensemble.mlpl"
include "../../src/retrieval/rebuild_escalation.mlpl"
include "../../src/retrieval/budget_selector.mlpl"
include "../../src/retrieval/budget_transfer.mlpl"
initial=[[2,0,0,0],[1.8,0.2,0,0],[-2,0,0,0],[-1.8,-0.2,0,0],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];iq=[[1.9,0.1,0,0],[-1.9,-0.1,0,0],[0.1,1.9,0,0],[-0.1,-1.9,0,0]]
shifted=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,0,0,2],[0,0,0.2,1.8],[0,0,0,-2],[0,0,-0.2,-1.8]];sq=[[0,0,1.9,0.1],[0,0,-1.9,-0.1],[0,0,0.1,1.9],[0,0,-0.1,-1.9]]
local_memory=[[0,0,2,0],[0,0,1.8,0.2],[0,0,-2,0],[0,0,-1.8,-0.2],[0,2,0,0],[0.2,1.8,0,0],[0,-2,0,0],[-0.2,-1.8,0,0]];local_queries=[[0,0,1.9,0.1],[0,0,1.7,0.25],[0,0,-1.9,-0.1],[0,0,-1.7,-0.25]];a=initial*0.33+shifted*0.67;aq=iq*0.33+sq*0.67;rotation_memory=concat(initial,a,0);scaled=iq*1.25
p11=randn(11,[4,8]);p17=randn(17,[4,8]);p29=randn(29,[4,8]);p83=randn(83,[4,8])
def u:single(v,q) { u:evaluate_projected(v,q,p83,8,1) };def u:ensemble(v,q) { u:evaluate_projection_ensemble3(v,q,p11,p17,p29,8,1) };def u:dense(v,q) { u:dense_fallback_summary(v,q) }
ls=u:single(local_memory,local_queries);le=u:ensemble(local_memory,local_queries);ld=u:dense(local_memory,local_queries);single_candidate=u:budget_candidate(1,ls.indexed_recall,ls.indexed_comparisons);ensemble_candidate=u:budget_candidate(2,le.final_recall,le.total_work);dense_candidate=u:budget_candidate(3,ld.recall,ld.comparisons);b8=u:select_retrieval_budget(8,single_candidate,ensemble_candidate,dense_candidate);b24=u:select_retrieval_budget(24,single_candidate,ensemble_candidate,dense_candidate)
rs=u:single(rotation_memory,aq);re=u:ensemble(rotation_memory,aq);rd=u:dense(rotation_memory,aq);ss=u:single(initial,scaled);se=u:ensemble(initial,scaled);sd=u:dense(initial,scaled)
local8=u:budget_transfer_result(8,b8,u:retrieval_mode_result(b8.mode,ls,le,ld));local24=u:budget_transfer_result(24,b24,u:retrieval_mode_result(b24.mode,ls,le,ld));rotation8=u:budget_transfer_result(8,b8,u:retrieval_mode_result(b8.mode,rs,re,rd));rotation24=u:budget_transfer_result(24,b24,u:retrieval_mode_result(b24.mode,rs,re,rd));scaling8=u:budget_transfer_result(8,b8,u:retrieval_mode_result(b8.mode,ss,se,sd));scaling24=u:budget_transfer_result(24,b24,u:retrieval_mode_result(b24.mode,ss,se,sd))
def u:transfer_row(workload,x) { [1,workload,x.budget,x.mode,x.validation_recall,x.validation_work,x.target_recall,x.target_work,x.recall_delta,x.budget_violation] }
print("schema workload budget mode validation_recall validation_work target_recall target_work recall_delta budget_violation")
print(u:transfer_row(1,local8));print(u:transfer_row(1,local24));print(u:transfer_row(2,rotation8));print(u:transfer_row(2,rotation24));print(u:transfer_row(3,scaling8));u:transfer_row(3,scaling24)
