#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=${MLPL:-"$repo_root/../sw-mlpl/target/debug/mlpl-repl"}
output=$(MLPL="$mlpl" "$repo_root/scripts/benchmark-metadata")
printf '%s\n' "$output" | rg -q '^meta schema 1$'
printf '%s\n' "$output" | rg -q '^meta sw_mlpl_version [0-9]'
printf '%s\n' "$output" | rg -q '^meta sw_mlpl_commit [0-9a-f]+'
printf '%s\n' "$output" | rg -q '^meta trials 3$'
echo "PASS benchmark_metadata"
