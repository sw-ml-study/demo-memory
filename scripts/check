#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

sh -n "$repo_root/scripts/check" "$repo_root/scripts/run-benchmark" "$repo_root/scripts/run-bloom-benchmark" "$repo_root/scripts/run-counting-bloom" "$repo_root/scripts/run-demo" "$repo_root/scripts/run-eviction-benchmark" "$repo_root/scripts/run-lru-benchmark" "$repo_root/scripts/run-probe-distributions" "$repo_root/scripts/run-timing-benchmark" "$repo_root/scripts/test"
"$repo_root/scripts/test"
"$repo_root/scripts/run-benchmark" >/dev/null
"$repo_root/scripts/run-demo" >/dev/null
"$repo_root/scripts/run-lru-benchmark" >/dev/null
"$repo_root/scripts/run-eviction-benchmark" >/dev/null
"$repo_root/scripts/run-bloom-benchmark" >/dev/null
"$repo_root/scripts/run-counting-bloom" >/dev/null
"$repo_root/scripts/run-timing-benchmark" >/dev/null
"$repo_root/scripts/run-probe-distributions" >/dev/null
git -C "$repo_root" diff --check

echo "PASS pre-commit"
