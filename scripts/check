#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

sh -n "$repo_root/scripts/benchmark-metadata" "$repo_root/scripts/check" "$repo_root/scripts/compare-benchmark-reports" "$repo_root/scripts/run-benchmark" "$repo_root/scripts/run-bloom-benchmark" "$repo_root/scripts/run-counting-bloom" "$repo_root/scripts/run-demo" "$repo_root/scripts/run-eviction-benchmark" "$repo_root/scripts/run-lru-benchmark" "$repo_root/scripts/run-probe-distributions" "$repo_root/scripts/run-timing-benchmark" "$repo_root/scripts/save-benchmark-report" "$repo_root/scripts/test" "$repo_root/scripts/test-benchmark-metadata" "$repo_root/scripts/test-benchmark-reports"
sh -n "$repo_root/scripts/compare-memory-reports" "$repo_root/scripts/run-memory-timing" "$repo_root/scripts/save-memory-report" "$repo_root/scripts/test-memory-reports"
"$repo_root/scripts/test"
"$repo_root/scripts/test-benchmark-metadata"
"$repo_root/scripts/test-benchmark-reports"
"$repo_root/scripts/test-memory-reports"
"$repo_root/scripts/run-memory-timing" >/dev/null
"$repo_root/scripts/run-packed-bloom" >/dev/null
"$repo_root/scripts/run-binary-retrieval" >/dev/null
"$repo_root/scripts/run-prefix-widths" >/dev/null
"$repo_root/scripts/run-multiprobe" >/dev/null
"$repo_root/scripts/run-sparse-aggregation" >/dev/null
"$repo_root/scripts/run-projected-codes" >/dev/null
"$repo_root/scripts/run-projection-sweep" >/dev/null
"$repo_root/scripts/run-data-derived-projection" >/dev/null
"$repo_root/scripts/run-distribution-shift" >/dev/null
"$repo_root/scripts/run-shift-rebuild-cadence" >/dev/null
"$repo_root/scripts/run-adaptive-rebuild" >/dev/null
"$repo_root/scripts/run-adaptive-threshold-samples" >/dev/null
"$repo_root/scripts/run-reservoir-shift-detection" >/dev/null
"$repo_root/scripts/run-reservoir-seed-trials" >/dev/null
"$repo_root/scripts/run-monitoring-policy-calibration" >/dev/null
"$repo_root/scripts/run-shift-shape-generalization" >/dev/null
"$repo_root/scripts/run-stratified-local-drift" >/dev/null
"$repo_root/scripts/run-recency-local-drift" >/dev/null
"$repo_root/scripts/run-benchmark" >/dev/null
"$repo_root/scripts/run-demo" >/dev/null
"$repo_root/scripts/run-lru-benchmark" >/dev/null
"$repo_root/scripts/run-eviction-benchmark" >/dev/null
"$repo_root/scripts/run-bloom-benchmark" >/dev/null
"$repo_root/scripts/run-counting-bloom" >/dev/null
"$repo_root/scripts/run-timing-benchmark" >/dev/null
"$repo_root/scripts/run-probe-distributions" >/dev/null
git -C "$repo_root" diff --check

echo "PASS pre-commit"
