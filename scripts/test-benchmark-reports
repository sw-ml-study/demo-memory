#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
output=$("$repo_root/scripts/compare-benchmark-reports" "$repo_root/tests/fixtures/timing-before.txt" "$repo_root/tests/fixtures/timing-after.txt")
printf '%s\n' "$output" | rg -q '^comparison 0 0 .* 10\.000 .* -10\.000$'
printf '%s\n' "$output" | rg -q '^comparison 1 0 .* 0\.000 .* 10\.000$'
echo "PASS benchmark_reports"
