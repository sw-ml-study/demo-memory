#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=${MLPL:-"$repo_root/../sw-mlpl/target/debug/mlpl-repl"}

if [ ! -x "$mlpl" ]; then
  echo "mlpl-repl is not executable: $mlpl" >&2
  exit 1
fi

"$mlpl" --source-dir "$repo_root" "$repo_root/tests/hash/open_addressing.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/bench/workload_matrix.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/bench/probe_distributions.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/kv/lru_memory.mlpl"
