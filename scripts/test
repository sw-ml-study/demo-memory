#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=${MLPL:-"$repo_root/../sw-mlpl/target/debug/mlpl-repl"}

if [ ! -x "$mlpl" ]; then
  echo "mlpl-repl is not executable: $mlpl" >&2
  exit 1
fi

"$mlpl" --source-dir "$repo_root" "$repo_root/tests/hash/open_addressing.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/bench/workload_matrix.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/bench/probe_distributions.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/kv/lru_memory.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/kv/fifo_vs_lru.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/bloom/filter.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/bloom/counting_filter.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/bloom/packed_filter.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/bench/native_timing.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/bench/memory_timing.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/binary_index.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/prefix_width_matrix.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/multiprobe.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/attention/sparse_aggregation.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/sign_projection.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/projection_sweep.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/covariance_projection.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/distribution_shift.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/shift_rebuild_cadence.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/adaptive_rebuild.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/adaptive_threshold_samples.mlpl"
"$mlpl" --source-dir "$repo_root" "$repo_root/tests/retrieval/reservoir_monitor.mlpl"
