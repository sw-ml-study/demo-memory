def u:hamming_weight(query,key) { d=1+u:hamming(query,key);1/(d*d) }
def u:dense_aggregate(keys,values,query) { i=0;numerator=0;denominator=0;while gt(tally(keys),i){w=u:hamming_weight(query,take(keys,0,i));numerator=numerator+w*take(values,0,i);denominator=denominator+w;i=i+1};{value: numerator/denominator,comparisons: tally(keys),fallback: 0} }
def u:sparse_aggregate(keys,values,query,width,radius) { qp=bmask(query,width);i=0;numerator=0;denominator=0;comparisons=0;while gt(tally(keys),i){key=take(keys,0,i);if 1-gt(u:hamming(qp,bmask(key,width)),radius){w=u:hamming_weight(query,key);numerator=numerator+w*take(values,0,i);denominator=denominator+w;comparisons=comparisons+1}else{0};i=i+1};if eq(comparisons,0){d=u:dense_aggregate(keys,values,query);{value: d.value,comparisons: d.comparisons,fallback: 1}}else{{value: numerator/denominator,comparisons: comparisons,fallback: 0}} }
def u:evaluate_sparse_aggregation(keys,values,queries,width,radius) { i=0;error=0;maximum=0;dense_work=0;sparse_work=0;fallbacks=0;while gt(tally(queries),i){q=take(queries,0,i);d=u:dense_aggregate(keys,values,q);s=u:sparse_aggregate(keys,values,q,width,radius);e=abs(d.value-s.value);error=error+e;if gt(e,maximum){maximum=e}else{0};dense_work=dense_work+d.comparisons;sparse_work=sparse_work+s.comparisons;fallbacks=fallbacks+s.fallback;i=i+1};{mean_error: error/tally(queries),max_error: maximum,dense_comparisons: dense_work,sparse_comparisons: sparse_work,fallbacks: fallbacks,reduction: 1-sparse_work/dense_work} }
