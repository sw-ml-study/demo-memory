def u:hamming(a,b) { "Return Hamming distance between exact integer codes."; popcount(bxor(a,b)) }
def u:nearest_exhaustive(codes,query) { "Scan every code and return nearest index, distance, and comparisons."; i=0;best=-1;best_d=0;while gt(tally(codes),i){d=u:hamming(query,take(codes,0,i));if eq(best,-1){best=i;best_d=d}else{if lt(d,best_d){best=i;best_d=d}else{0}};i=i+1};{index: best,distance: best_d,comparisons: tally(codes),fallback: 0} }
def u:nearest_prefix(codes,query,prefix_width) { "Search codes sharing low prefix bits, falling back when bucket is empty."; prefix=bmask(query,prefix_width);i=0;best=-1;best_d=0;comparisons=0;while gt(tally(codes),i){code=take(codes,0,i);if eq(bmask(code,prefix_width),prefix){d=u:hamming(query,code);comparisons=comparisons+1;if eq(best,-1){best=i;best_d=d}else{if lt(d,best_d){best=i;best_d=d}else{0}}}else{0};i=i+1};if eq(best,-1){r=u:nearest_exhaustive(codes,query);{index: r.index,distance: r.distance,comparisons: r.comparisons,fallback: 1}}else{{index: best,distance: best_d,comparisons: comparisons,fallback: 0}} }
def u:evaluate_prefix(codes,queries,prefix_width) { "Compare shortlist answers with exhaustive nearest neighbors.";i=0;recall=0;full=0;short=0;fallbacks=0;while gt(tally(queries),i){q=take(queries,0,i);e=u:nearest_exhaustive(codes,q);s=u:nearest_prefix(codes,q,prefix_width);recall=recall+eq(e.index,s.index);full=full+e.comparisons;short=short+s.comparisons;fallbacks=fallbacks+s.fallback;i=i+1};{queries: tally(queries),recall: recall/tally(queries),exhaustive_comparisons: full,shortlist_comparisons: short,fallbacks: fallbacks,reduction: 1-short/full} }
