include "./reservoir_monitor.mlpl"
include "./distribution_shift.mlpl"
def u:reservoir_detection_trial(stream,memory,model,size,seed,threshold) { "Return first shifted-query checkpoint detected; 6 is the censored non-detection sentinel.";s6=u:reservoir_sample(stream,6,size,seed);r6=u:evaluate_projection_model(memory,s6.rows,model,4,1);if lt(r6.hamming_recall,threshold){{detected: 1,delay: 2,monitored: size*2}}else{s8=u:reservoir_sample(stream,8,size,seed);r8=u:evaluate_projection_model(memory,s8.rows,model,4,1);if lt(r8.hamming_recall,threshold){{detected: 1,delay: 4,monitored: size*3}}else{{detected: 0,delay: 6,monitored: size*3}}} }
def u:reservoir_trials_from(stream,memory,model,size,seeds,threshold,index,detected,delays,monitored) { if eq(index,tally(seeds)){{detected: detected,delays: delays,monitored: monitored}}else{trial=u:reservoir_detection_trial(stream,memory,model,size,take(seeds,0,index),threshold);u:reservoir_trials_from(stream,memory,model,size,seeds,threshold,index+1,concat(detected,trial.detected),concat(delays,trial.delay),concat(monitored,trial.monitored))} }
def u:delay_percentile(delays,fraction) { "Nearest-rank delay over values 2/4/6, where 6 means censored non-detection.";target=ceil(tally(delays)*fraction);at2=reduce_add(eq(delays,2),0);at4=reduce_add(eq(delays,4),0);if 1-lt(at2,target){2}else{if 1-lt(at2+at4,target){4}else{6}} }
def u:reservoir_trial_summary(stream,memory,model,size,seeds,threshold) { trials=u:reservoir_trials_from(stream,memory,model,size,seeds,threshold,0,[],[],[]);{size: size,trials: tally(seeds),detection_rate: reduce_add(trials.detected,0)/tally(seeds),p50_delay: u:delay_percentile(trials.delays,0.5),p95_delay: u:delay_percentile(trials.delays,0.95),mean_monitored: reduce_add(trials.monitored,0)/tally(seeds),delays: trials.delays} }
