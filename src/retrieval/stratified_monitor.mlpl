include "./reservoir_trials.mlpl"
def u:two_stratum_sample(first,first_count,second,second_count,seed) { "Keep one deterministic reservoir query from each explicit stratum.";a=u:reservoir_sample(first,first_count,1,seed);b=u:reservoir_sample(second,second_count,1,seed+101);concat(a.rows,b.rows,0) }
def u:stratified_detection_trial(first,second,memory,model,seed,threshold) { "Detect after two/four affected-stratum queries; 6 is censored non-detection.";q2=u:two_stratum_sample(first,4,second,2,seed);r2=u:evaluate_projection_model(memory,q2,model,4,1);if lt(r2.hamming_recall,threshold){{detected: 1,delay: 2,monitored: 2}}else{q4=u:two_stratum_sample(first,4,second,4,seed);r4=u:evaluate_projection_model(memory,q4,model,4,1);if lt(r4.hamming_recall,threshold){{detected: 1,delay: 4,monitored: 4}}else{{detected: 0,delay: 6,monitored: 4}}} }
def u:stratified_trials_from(first,second,memory,model,seeds,threshold,index,detected,delays,monitored) { if eq(index,tally(seeds)){{detected: detected,delays: delays,monitored: monitored}}else{trial=u:stratified_detection_trial(first,second,memory,model,take(seeds,0,index),threshold);u:stratified_trials_from(first,second,memory,model,seeds,threshold,index+1,concat(detected,trial.detected),concat(delays,trial.delay),concat(monitored,trial.monitored))} }
def u:stratified_trial_summary(first,second,memory,model,seeds,threshold) { trials=u:stratified_trials_from(first,second,memory,model,seeds,threshold,0,[],[],[]);{trials: tally(seeds),detection_rate: reduce_add(trials.detected,0)/tally(seeds),p50_delay: u:delay_percentile(trials.delays,0.5),p95_delay: u:delay_percentile(trials.delays,0.95),mean_monitored: reduce_add(trials.monitored,0)/tally(seeds)} }
