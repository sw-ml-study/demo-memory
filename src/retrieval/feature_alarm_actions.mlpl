include "./distribution_shift.mlpl"
include "./feature_drift.mlpl"
def u:immediate_feature_action(memory,early_queries,evaluation_queries,retrieval_model,subspace_model,width,radius,feature_threshold) { "Rebuild immediately when the feature statistic alarms.";alarm=u:feature_drift_alarm(early_queries,subspace_model,feature_threshold);early=u:evaluate_projection_model(memory,early_queries,retrieval_model,width,radius);if alarm.alarm{next=u:covariance_projection(memory,width);result=u:evaluate_projection_model(memory,evaluation_queries,next,width,radius);work=u:projection_rebuild_work(memory,width);{alarm: 1,early_recall: early.hamming_recall,rebuilt: 1,delay: 2,rebuild_cells: work.cells,post_recall: result.hamming_recall}}else{result=u:evaluate_projection_model(memory,evaluation_queries,retrieval_model,width,radius);{alarm: 0,early_recall: early.hamming_recall,rebuilt: 0,delay: 6,rebuild_cells: 0,post_recall: result.hamming_recall}} }
def u:confirmed_feature_action(memory,early_queries,evaluation_queries,retrieval_model,subspace_model,width,radius,feature_threshold,recall_threshold) { "After a feature alarm, rebuild at the first recall checkpoint below threshold.";alarm=u:feature_drift_alarm(early_queries,subspace_model,feature_threshold);early=u:evaluate_projection_model(memory,early_queries,retrieval_model,width,radius);full=u:evaluate_projection_model(memory,evaluation_queries,retrieval_model,width,radius);if alarm.alarm*lt(early.hamming_recall,recall_threshold){next=u:covariance_projection(memory,width);result=u:evaluate_projection_model(memory,evaluation_queries,next,width,radius);work=u:projection_rebuild_work(memory,width);{alarm: 1,early_recall: early.hamming_recall,rebuilt: 1,delay: 2,rebuild_cells: work.cells,post_recall: result.hamming_recall}}else{if alarm.alarm*lt(full.hamming_recall,recall_threshold){next=u:covariance_projection(memory,width);result=u:evaluate_projection_model(memory,evaluation_queries,next,width,radius);work=u:projection_rebuild_work(memory,width);{alarm: 1,early_recall: early.hamming_recall,rebuilt: 1,delay: 4,rebuild_cells: work.cells,post_recall: result.hamming_recall}}else{{alarm: alarm.alarm,early_recall: early.hamming_recall,rebuilt: 0,delay: 6,rebuild_cells: 0,post_recall: full.hamming_recall}}} }
