include "./sign_projection.mlpl"
include "./covariance_projection.mlpl"
def u:center_vectors(vectors,mean) { vectors-matmul(ones([take(shape(vectors),0,0),1]),reshape(mean,[1,tally(mean)])) }
def u:evaluate_distribution_shift(initial,initial_queries,arrivals,shifted_queries,width,radius) { "Compare an initial covariance index before shift, after arrivals, and after rebuilding.";old=u:covariance_projection(initial,width);before=u:evaluate_projected(old.centered,u:center_queries(initial_queries,old.mean),old.projection,width,radius);combined=concat(initial,arrivals,0);stale=u:evaluate_projected(u:center_vectors(combined,old.mean),u:center_queries(shifted_queries,old.mean),old.projection,width,radius);fresh=u:covariance_projection(combined,width);rebuilt=u:evaluate_projected(fresh.centered,u:center_queries(shifted_queries,fresh.mean),fresh.projection,width,radius);rows=take(shape(combined),0,0);dimension=take(shape(combined),0,1);{before: before,stale: stale,rebuilt: rebuilt,rebuild_rows: rows,rebuild_cells: rows*dimension,power_steps: 20*width} }
def u:evaluate_projection_model(vectors,queries,model,width,radius) { "Evaluate current memory through an existing, possibly stale projection model.";u:evaluate_projected(u:center_vectors(vectors,model.mean),u:center_queries(queries,model.mean),model.projection,width,radius) }
def u:projection_rebuild_work(vectors,width) { "Expose deterministic input and iteration work for one projection rebuild.";rows=take(shape(vectors),0,0);dimension=take(shape(vectors),0,1);{rows: rows,cells: rows*dimension,power_steps: 20*width} }
def u:adaptive_projection_step(vectors,queries,model,width,radius,threshold) { "Sample recall and rebuild only when it falls below threshold.";observed=u:evaluate_projection_model(vectors,queries,model,width,radius);if lt(observed.hamming_recall,threshold){next=u:covariance_projection(vectors,width);result=u:evaluate_projection_model(vectors,queries,next,width,radius);work=u:projection_rebuild_work(vectors,width);{model: next,result: result,observed_recall: observed.hamming_recall,rebuilt: 1,rebuild_cells: work.cells,power_steps: work.power_steps}}else{{model: model,result: observed,observed_recall: observed.hamming_recall,rebuilt: 0,rebuild_cells: 0,power_steps: 0}} }
