include "./sign_projection.mlpl"
include "./covariance_projection.mlpl"
def u:center_vectors(vectors,mean) { vectors-matmul(ones([take(shape(vectors),0,0),1]),reshape(mean,[1,tally(mean)])) }
def u:evaluate_distribution_shift(initial,initial_queries,arrivals,shifted_queries,width,radius) { "Compare an initial covariance index before shift, after arrivals, and after rebuilding.";old=u:covariance_projection(initial,width);before=u:evaluate_projected(old.centered,u:center_queries(initial_queries,old.mean),old.projection,width,radius);combined=concat(initial,arrivals,0);stale=u:evaluate_projected(u:center_vectors(combined,old.mean),u:center_queries(shifted_queries,old.mean),old.projection,width,radius);fresh=u:covariance_projection(combined,width);rebuilt=u:evaluate_projected(fresh.centered,u:center_queries(shifted_queries,fresh.mean),fresh.projection,width,radius);rows=take(shape(combined),0,0);dimension=take(shape(combined),0,1);{before: before,stale: stale,rebuilt: rebuilt,rebuild_rows: rows,rebuild_cells: rows*dimension,power_steps: 20*width} }
