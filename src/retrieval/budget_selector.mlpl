def u:budget_candidate(mode,recall,work) { {mode: mode,recall: recall,work: work,feasible: 1} }
def u:budget_consider(best,candidate,budget) { "Prefer higher validated recall within budget, then lower work.";fits=1-lt(budget,candidate.work);better=(1-best.feasible)+gt(candidate.recall,best.recall)+eq(candidate.recall,best.recall)*lt(candidate.work,best.work);if fits*gt(better,0){candidate}else{best} }
def u:select_retrieval_budget(budget,single,ensemble,dense) { empty={mode: 0,recall: 0,work: 0,feasible: 0};a=u:budget_consider(empty,single,budget);b=u:budget_consider(a,ensemble,budget);u:budget_consider(b,dense,budget) }
