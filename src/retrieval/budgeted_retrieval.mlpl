def u:nearest_multiprobe_budgeted(codes,query,width,radius,budget) { "Scan matching candidates without exceeding a hard comparison budget; no unbudgeted fallback.";qp=bmask(query,width);i=0;best=-1;best_d=0;comparisons=0;while gt(tally(codes),i)*gt(budget,comparisons){code=take(codes,0,i);cp=bmask(code,width);if 1-gt(u:hamming(qp,cp),radius){d=u:hamming(query,code);comparisons=comparisons+1;if eq(best,-1){best=i;best_d=d}else{if lt(d,best_d){best=i;best_d=d}else{0}}}else{0};i=i+1};{index: best,distance: best_d,comparisons: comparisons,completed: eq(i,tally(codes)),exhausted: lt(i,tally(codes))} }
def u:evaluate_budgeted_single(vectors,queries,projection,width,radius,budget) { codes=u:project_codes(vectors,projection);qcodes=u:project_codes(queries,projection);i=0;correct=0;remaining=budget;exhausted=0;completed=0;while gt(tally(qcodes),i){dense=u:dot_nearest(vectors,take(queries,0,i));r=u:nearest_multiprobe_budgeted(codes,take(qcodes,0,i),width,radius,remaining);remaining=remaining-r.comparisons;correct=correct+eq(r.index,dense.index);exhausted=exhausted+r.exhausted;completed=completed+r.completed;i=i+1};{recall: correct/tally(qcodes),comparisons: budget-remaining,exhausted_queries: exhausted,completed_projections: completed} }
def u:evaluate_budgeted_ensemble3(vectors,queries,p1,p2,p3,width,radius,budget) { c1=u:project_codes(vectors,p1);c2=u:project_codes(vectors,p2);c3=u:project_codes(vectors,p3);q1=u:project_codes(queries,p1);q2=u:project_codes(queries,p2);q3=u:project_codes(queries,p3);i=0;correct=0;remaining=budget;exhausted=0;completed=0;unanimous=0;fallbacks=0;while gt(tally(q1),i){dense=u:dot_nearest(vectors,take(queries,0,i));a=u:nearest_multiprobe_budgeted(c1,take(q1,0,i),width,radius,remaining);remaining=remaining-a.comparisons;b=u:nearest_multiprobe_budgeted(c2,take(q2,0,i),width,radius,remaining);remaining=remaining-b.comparisons;c=u:nearest_multiprobe_budgeted(c3,take(q3,0,i),width,radius,remaining);remaining=remaining-c.comparisons;completed=completed+a.completed+b.completed+c.completed;all=a.completed*b.completed*c.completed;choice=if all{u:unanimous_choice(a.index,b.index,c.index)}else{-1};if 1-eq(choice,-1){unanimous=unanimous+1;selected=choice}else{if 1-lt(remaining,dense.comparisons){fallbacks=fallbacks+1;remaining=remaining-dense.comparisons;selected=dense.index}else{selected=if 1-eq(a.index,-1){a.index}else{if 1-eq(b.index,-1){b.index}else{c.index}}}};exhausted=exhausted+gt((1-a.completed)+(1-b.completed)+(1-c.completed),0);correct=correct+eq(selected,dense.index);i=i+1};{recall: correct/tally(q1),comparisons: budget-remaining,exhausted_queries: exhausted,completed_projections: completed,unanimous_queries: unanimous,dense_fallbacks: fallbacks} }
