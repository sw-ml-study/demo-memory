def u:unanimous_choice(a,b,c) { if eq(a,b)*eq(a,c){a}else{-1} }
def u:evaluate_projection_ensemble3(vectors,queries,p1,p2,p3,width,radius) { "Use an indexed answer only when all three projection indexes agree; otherwise use dense fallback.";c1=u:project_codes(vectors,p1);c2=u:project_codes(vectors,p2);c3=u:project_codes(vectors,p3);q1=u:project_codes(queries,p1);q2=u:project_codes(queries,p2);q3=u:project_codes(queries,p3);i=0;agreed=0;agreed_correct=0;fallbacks=0;correct=0;index_work=0;fallback_work=0;while gt(tally(q1),i){dense=u:dot_nearest(vectors,take(queries,0,i));a=u:nearest_multiprobe(c1,take(q1,0,i),width,radius);b=u:nearest_multiprobe(c2,take(q2,0,i),width,radius);c=u:nearest_multiprobe(c3,take(q3,0,i),width,radius);choice=u:unanimous_choice(a.index,b.index,c.index);index_work=index_work+a.comparisons+b.comparisons+c.comparisons;if eq(choice,-1){fallbacks=fallbacks+1;fallback_work=fallback_work+dense.comparisons;correct=correct+1}else{agreed=agreed+1;hit=eq(choice,dense.index);agreed_correct=agreed_correct+hit;correct=correct+hit};i=i+1};{queries: tally(q1),agreement_rate: agreed/tally(q1),agreed_recall: if gt(agreed,0){agreed_correct/agreed}else{0},fallback_queries: fallbacks,final_recall: correct/tally(q1),index_work: index_work,fallback_work: fallback_work,total_work: index_work+fallback_work} }
