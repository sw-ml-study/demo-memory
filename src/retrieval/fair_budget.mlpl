def u:scheduled_query_quota(total,count,index,round_robin) { "Equal floor quota, with round-robin assigning remainder tokens to earliest queries.";base=floor(total/count);remainder=total-base*count;base+round_robin*lt(index,remainder) }
def u:evaluate_fair_single(vectors,queries,projection,width,radius,total,round_robin) { i=0;correct=0;work=0;exhausted=0;completed=0;while gt(take(shape(queries),0,0),i){quota=u:scheduled_query_quota(total,take(shape(queries),0,0),i,round_robin);one=reshape(take(queries,0,i),[1,take(shape(queries),0,1)]);r=u:evaluate_budgeted_single(vectors,one,projection,width,radius,quota);correct=correct+r.recall;work=work+r.comparisons;exhausted=exhausted+r.exhausted_queries;completed=completed+r.completed_projections;i=i+1};{recall: correct/take(shape(queries),0,0),comparisons: work,exhausted_queries: exhausted,completed_projections: completed,unanimous_queries: 0,dense_fallbacks: 0} }
def u:evaluate_fair_ensemble3(vectors,queries,p1,p2,p3,width,radius,total,round_robin) { i=0;correct=0;work=0;exhausted=0;completed=0;unanimous=0;fallbacks=0;while gt(take(shape(queries),0,0),i){quota=u:scheduled_query_quota(total,take(shape(queries),0,0),i,round_robin);one=reshape(take(queries,0,i),[1,take(shape(queries),0,1)]);r=u:evaluate_budgeted_ensemble3(vectors,one,p1,p2,p3,width,radius,quota);correct=correct+r.recall;work=work+r.comparisons;exhausted=exhausted+r.exhausted_queries;completed=completed+r.completed_projections;unanimous=unanimous+r.unanimous_queries;fallbacks=fallbacks+r.dense_fallbacks;i=i+1};{recall: correct/take(shape(queries),0,0),comparisons: work,exhausted_queries: exhausted,completed_projections: completed,unanimous_queries: unanimous,dense_fallbacks: fallbacks} }
