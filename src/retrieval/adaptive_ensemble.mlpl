def u:majority_choice(a,b,c) { if eq(a,b){a}else{if eq(a,c){a}else{if eq(b,c){b}else{-1}}} }
def u:adaptive_ensemble_query(vectors,query,c1,c2,c3,q1,q2,q3,width,radius,budget) { "Stop after two completed agreeing projections; otherwise run a third and use majority.";dense=u:dot_nearest(vectors,query);remaining=budget;a=u:nearest_multiprobe_budgeted(c1,q1,width,radius,remaining);remaining=remaining-a.comparisons;b=u:nearest_multiprobe_budgeted(c2,q2,width,radius,remaining);remaining=remaining-b.comparisons;early=a.completed*b.completed*eq(a.index,b.index);if early{choice=a.index;third=0;completed=a.completed+b.completed;exhausted=gt((1-a.completed)+(1-b.completed),0);fallback=0}else{c=u:nearest_multiprobe_budgeted(c3,q3,width,radius,remaining);remaining=remaining-c.comparisons;third=1;completed=a.completed+b.completed+c.completed;exhausted=gt((1-a.completed)+(1-b.completed)+(1-c.completed),0);choice=u:majority_choice(a.index,b.index,c.index);if eq(choice,-1)*(1-lt(remaining,dense.comparisons)){remaining=remaining-dense.comparisons;choice=dense.index;fallback=1}else{fallback=0}};{correct: eq(choice,dense.index),comparisons: budget-remaining,exhausted: exhausted,completed: completed,early: early,third: third,fallback: fallback} }
def u:evaluate_adaptive_ensemble3(vectors,queries,p1,p2,p3,width,radius,budget) { c1=u:project_codes(vectors,p1);c2=u:project_codes(vectors,p2);c3=u:project_codes(vectors,p3);q1=u:project_codes(queries,p1);q2=u:project_codes(queries,p2);q3=u:project_codes(queries,p3);i=0;remaining=budget;correct=0;exhausted=0;completed=0;early=0;third=0;fallbacks=0;while gt(tally(q1),i){r=u:adaptive_ensemble_query(vectors,take(queries,0,i),c1,c2,c3,take(q1,0,i),take(q2,0,i),take(q3,0,i),width,radius,remaining);remaining=remaining-r.comparisons;correct=correct+r.correct;exhausted=exhausted+r.exhausted;completed=completed+r.completed;early=early+r.early;third=third+r.third;fallbacks=fallbacks+r.fallback;i=i+1};{recall: correct/tally(q1),comparisons: budget-remaining,exhausted_queries: exhausted,completed_projections: completed,early_agreements: early,third_projections: third,dense_fallbacks: fallbacks} }
def u:evaluate_fair_adaptive_ensemble3(vectors,queries,p1,p2,p3,width,radius,total) { c1=u:project_codes(vectors,p1);c2=u:project_codes(vectors,p2);c3=u:project_codes(vectors,p3);q1=u:project_codes(queries,p1);q2=u:project_codes(queries,p2);q3=u:project_codes(queries,p3);i=0;correct=0;work=0;exhausted=0;completed=0;early=0;third=0;fallbacks=0;while gt(tally(q1),i){quota=u:scheduled_query_quota(total,tally(q1),i,1);r=u:adaptive_ensemble_query(vectors,take(queries,0,i),c1,c2,c3,take(q1,0,i),take(q2,0,i),take(q3,0,i),width,radius,quota);work=work+r.comparisons;correct=correct+r.correct;exhausted=exhausted+r.exhausted;completed=completed+r.completed;early=early+r.early;third=third+r.third;fallbacks=fallbacks+r.fallback;i=i+1};{recall: correct/tally(q1),comparisons: work,exhausted_queries: exhausted,completed_projections: completed,early_agreements: early,third_projections: third,dense_fallbacks: fallbacks} }
