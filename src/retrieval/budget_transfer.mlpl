def u:retrieval_mode_result(mode,single,ensemble,dense) { if eq(mode,1){{recall: single.indexed_recall,work: single.indexed_comparisons}}else{if eq(mode,2){{recall: ensemble.final_recall,work: ensemble.total_work}}else{{recall: dense.recall,work: dense.comparisons}}} }
def u:budget_transfer_result(budget,selected,target) { "Compare frozen validation choice with its target-workload result.";{budget: budget,mode: selected.mode,validation_recall: selected.recall,validation_work: selected.work,target_recall: target.recall,target_work: target.work,recall_delta: target.recall-selected.recall,budget_violation: lt(budget,target.work)} }
