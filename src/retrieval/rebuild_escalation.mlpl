def u:dense_fallback_summary(vectors,queries) { "Return exact dense fallback quality and comparison work.";rows=take(shape(vectors),0,0);count=take(shape(queries),0,0);{recall: 1,comparisons: rows*count} }
def u:validated_dense_fallback(indexed,dense,threshold) { "Use dense retrieval when validation recall is below threshold.";fallback=lt(indexed.indexed_recall,threshold);{fallback: fallback,recall: if fallback{dense.recall}else{indexed.indexed_recall},index_work: indexed.indexed_comparisons,fallback_work: if fallback{dense.comparisons}else{0},total_work: indexed.indexed_comparisons+if fallback{dense.comparisons}else{0}} }
