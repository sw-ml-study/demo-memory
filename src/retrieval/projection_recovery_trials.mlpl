def u:recovery_min_from(values,index,best) { if eq(index,tally(values)){best}else{value=take(values,0,index);u:recovery_min_from(values,index+1,if lt(value,best){value}else{best})} }
def u:recovery_max_from(values,index,best) { if eq(index,tally(values)){best}else{value=take(values,0,index);u:recovery_max_from(values,index+1,if gt(value,best){value}else{best})} }
def u:projection_recovery_trials_from(vectors,queries,width,seeds,radius,index,recalls,indexed,work) { if eq(index,tally(seeds)){{recalls: recalls,indexed: indexed,work: work}}else{projection=randn(take(seeds,0,index),[take(shape(vectors),0,1),width]);result=u:evaluate_projected(vectors,queries,projection,width,radius);u:projection_recovery_trials_from(vectors,queries,width,seeds,radius,index+1,concat(recalls,result.hamming_recall),concat(indexed,result.indexed_recall),concat(work,result.indexed_comparisons))} }
def u:projection_recovery_summary(vectors,queries,width,seeds,radius,threshold) { trials=u:projection_recovery_trials_from(vectors,queries,width,seeds,radius,0,[],[],[]);count=tally(seeds);{width: width,trials: count,recall_min: u:recovery_min_from(trials.recalls,1,take(trials.recalls,0,0)),recall_mean: reduce_add(trials.recalls,0)/count,recall_max: u:recovery_max_from(trials.recalls,1,take(trials.recalls,0,0)),success_rate: reduce_add(1-lt(trials.recalls,threshold),0)/count,indexed_mean: reduce_add(trials.indexed,0)/count,work_mean: reduce_add(trials.work,0)/count} }
