def u:project_code(vector,projection) { "Project a vector and pack sign bits LSB-first."; scores=reshape(matmul(reshape(vector,[1,tally(vector)]),projection),[take(shape(projection),0,1)]);from_bits(gt(scores,0)) }
def u:project_codes_from(vectors,projection,index) { if eq(index,take(shape(vectors),0,0)){[]}else{concat(u:project_code(take(vectors,0,index),projection),u:project_codes_from(vectors,projection,index+1))} }
def u:project_codes(vectors,projection) { "Encode every vector row as one exact integer code."; u:project_codes_from(vectors,projection,0) }
def u:dot_nearest(vectors,query) { "Return maximum dot-product row index and comparisons.";i=0;best=-1;best_score=0;while gt(take(shape(vectors),0,0),i){score=reduce_add(take(vectors,0,i)*query,0);if eq(best,-1){best=i;best_score=score}else{if gt(score,best_score){best=i;best_score=score}else{0}};i=i+1};{index: best,score: best_score,comparisons: take(shape(vectors),0,0)} }
def u:evaluate_projected(vectors,queries,projection,width,radius) { codes=u:project_codes(vectors,projection);query_codes=u:project_codes(queries,projection);i=0;hamming_recall=0;indexed_recall=0;dense_work=0;hamming_work=0;indexed_work=0;while gt(tally(query_codes),i){dense=u:dot_nearest(vectors,take(queries,0,i));h=u:nearest_exhaustive(codes,take(query_codes,0,i));s=u:nearest_multiprobe(codes,take(query_codes,0,i),width,radius);hamming_recall=hamming_recall+eq(dense.index,h.index);indexed_recall=indexed_recall+eq(dense.index,s.index);dense_work=dense_work+dense.comparisons;hamming_work=hamming_work+h.comparisons;indexed_work=indexed_work+s.comparisons;i=i+1};{codes: codes,queries: tally(query_codes),hamming_recall: hamming_recall/tally(query_codes),indexed_recall: indexed_recall/tally(query_codes),dense_comparisons: dense_work,hamming_comparisons: hamming_work,indexed_comparisons: indexed_work,reduction: 1-indexed_work/dense_work} }
