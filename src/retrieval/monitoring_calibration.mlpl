include "./reservoir_trials.mlpl"
def u:monitoring_calibration(shift_stream,shift_memory,control_stream,control_memory,model,size,seeds,threshold) { "Compare one reservoir policy on shifted and all-healthy streams.";shift=u:reservoir_trial_summary(shift_stream,shift_memory,model,size,seeds,threshold);control=u:reservoir_trial_summary(control_stream,control_memory,model,size,seeds,threshold);{size: size,threshold: threshold,trials: tally(seeds),detection_rate: shift.detection_rate,p50_delay: shift.p50_delay,p95_delay: shift.p95_delay,mean_monitored: shift.mean_monitored,false_trigger_rate: control.detection_rate} }
