def u:nearest_multiprobe(codes,query,width,radius) { "Search prefix buckets within Hamming radius, with exhaustive fallback."; qp=bmask(query,width);i=0;best=-1;best_d=0;comparisons=0;while gt(tally(codes),i){code=take(codes,0,i);cp=bmask(code,width);if 1-gt(u:hamming(qp,cp),radius){d=u:hamming(query,code);comparisons=comparisons+1;if eq(best,-1){best=i;best_d=d}else{if lt(d,best_d){best=i;best_d=d}else{0}}}else{0};i=i+1};if eq(best,-1){r=u:nearest_exhaustive(codes,query);{index: r.index,distance: r.distance,comparisons: r.comparisons,fallback: 1}}else{{index: best,distance: best_d,comparisons: comparisons,fallback: 0}} }
def u:evaluate_multiprobe(codes,queries,width,radius) { "Compare multi-probe answers with exhaustive search.";i=0;recall=0;full=0;short=0;fallbacks=0;while gt(tally(queries),i){q=take(queries,0,i);e=u:nearest_exhaustive(codes,q);s=u:nearest_multiprobe(codes,q,width,radius);recall=recall+eq(e.index,s.index);full=full+e.comparisons;short=short+s.comparisons;fallbacks=fallbacks+s.fallback;i=i+1};{queries: tally(queries),recall: recall/tally(queries),exhaustive: full,shortlist: short,fallbacks: fallbacks,average: short/tally(queries),reduction: 1-short/full} }
