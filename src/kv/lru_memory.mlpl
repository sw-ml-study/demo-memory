# A bounded numeric key/value memory with least-recently-used eviction.
# Slot handles are bounded array indices; last_used is a logical clock.

def u:lru_new(capacity) { "Create an empty fixed-capacity LRU key/value memory."; {active: fill([capacity], 0), keys: fill([capacity], 0), values: fill([capacity], 0), last_used: fill([capacity], 0), capacity: capacity, size: 0, clock: 0} }
def u:lru_find_from(memory, key, index) { "Return the active slot for key or -1."; if eq(index, memory.capacity) { -1 } else { if eq(take(memory.active, 0, index), 1) * eq(take(memory.keys, 0, index), key) { index } else { u:lru_find_from(memory, key, index + 1) } } }
def u:lru_free_from(memory, index) { "Return the first inactive slot or -1."; if eq(index, memory.capacity) { -1 } else { if eq(take(memory.active, 0, index), 0) { index } else { u:lru_free_from(memory, index + 1) } } }
def u:lru_oldest_from(memory, index, best, best_tick) { "Return the least-recently-used active slot.";
  if eq(index, memory.capacity) { best } else {
    active = take(memory.active, 0, index);
    tick = take(memory.last_used, 0, index);
    choose = if eq(active, 0) { 0 } else { if eq(best, -1) { 1 } else { lt(tick, best_tick) } };
    u:lru_oldest_from(memory, index + 1, if choose { index } else { best }, if choose { tick } else { best_tick })
  }
}
def u:lru_oldest(memory) { "Return the least-recently-used active slot."; u:lru_oldest_from(memory, 0, -1, 0) }

def u:lru_step(memory, key, value) { "Access key, loading value on a miss, and return event metrics.";
  slot = u:lru_find_from(memory, key, 0);
  if gt(slot, -1) {
    promoted = 1 - eq(take(memory.last_used, 0, slot), memory.clock - 1);
    next = {active: memory.active, keys: memory.keys, values: memory.values, last_used: scatter(memory.last_used, slot, memory.clock), capacity: memory.capacity, size: memory.size, clock: memory.clock + 1};
    {memory: next, value: take(memory.values, 0, slot), hit: 1, miss: 0, promoted: promoted, evicted: 0, evicted_key: -1}
  } else {
    full = eq(memory.size, memory.capacity);
    target = if full { u:lru_oldest(memory) } else { u:lru_free_from(memory, 0) };
    victim = if full { take(memory.keys, 0, target) } else { -1 };
    next = {active: scatter(memory.active, target, 1), keys: scatter(memory.keys, target, key), values: scatter(memory.values, target, value), last_used: scatter(memory.last_used, target, memory.clock), capacity: memory.capacity, size: if full { memory.size } else { memory.size + 1 }, clock: memory.clock + 1};
    {memory: next, value: value, hit: 0, miss: 1, promoted: 0, evicted: full, evicted_key: victim}
  }
}

def u:lru_count_from(values, wanted, index) { "Count matching vector values."; if eq(index, tally(values)) { 0 } else { eq(take(values, 0, index), wanted) + u:lru_count_from(values, wanted, index + 1) } }
def u:lru_valid(memory) { "Check parallel-array shapes, capacity, size, and logical clock invariants.";
  shapes = eq(tally(memory.active), memory.capacity) * eq(tally(memory.keys), memory.capacity) * eq(tally(memory.values), memory.capacity) * eq(tally(memory.last_used), memory.capacity);
  shapes * gt(memory.capacity, 0) * eq(u:lru_count_from(memory.active, 1, 0), memory.size) * (1 - gt(memory.size, memory.capacity)) * (1 - lt(memory.clock, memory.size))
}

def u:lru_trace_from(memory, keys, index, hits, misses, promotions, evictions) { "Run the remaining demand-load trace and accumulate event counts.";
  if eq(index, tally(keys)) { {memory: memory, accesses: tally(keys), hits: hits, misses: misses, promotions: promotions, evictions: evictions} } else {
    key = take(keys, 0, index);
    event = u:lru_step(memory, key, key * 10 + 1);
    u:lru_trace_from(event.memory, keys, index + 1, hits + event.hit, misses + event.miss, promotions + event.promoted, evictions + event.evicted)
  }
}
def u:lru_trace(capacity, keys) { "Run a deterministic demand-load access trace."; u:lru_trace_from(u:lru_new(capacity), keys, 0, 0, 0, 0, 0) }
