def u:counting_new(bit_count, hash_count) { "Create an empty logical counting Bloom filter."; {counters: fill([bit_count], 0), bit_count: bit_count, hash_count: hash_count, inserts: 0, removals: 0} }
def u:counting_adjust(filter, key, hash_index, delta) { "Adjust every selected counter."; if eq(hash_index, filter.hash_count) { filter } else { index = u:bloom_hash(key, hash_index, filter.bit_count); next = {counters: scatter(filter.counters, index, take(filter.counters, 0, index) + delta), bit_count: filter.bit_count, hash_count: filter.hash_count, inserts: filter.inserts, removals: filter.removals}; u:counting_adjust(next, key, hash_index + 1, delta) } }
def u:counting_can_remove(filter, key, hash_index) { "Return whether every selected counter is positive."; if eq(hash_index, filter.hash_count) { 1 } else { index = u:bloom_hash(key, hash_index, filter.bit_count); if gt(take(filter.counters, 0, index), 0) { u:counting_can_remove(filter, key, hash_index + 1) } else { 0 } } }
def u:counting_insert(filter, key) { "Increment selected counters for one occurrence."; adjusted = u:counting_adjust(filter, key, 0, 1); {counters: adjusted.counters, bit_count: filter.bit_count, hash_count: filter.hash_count, inserts: filter.inserts + 1, removals: filter.removals} }
def u:counting_remove(filter, key) { "Remove one occurrence when counters cannot underflow."; if u:counting_can_remove(filter, key, 0) { adjusted = u:counting_adjust(filter, key, 0, -1); ok({counters: adjusted.counters, bit_count: filter.bit_count, hash_count: filter.hash_count, inserts: filter.inserts, removals: filter.removals + 1}) } else { err({kind: "underflow", message: "selected counter is zero"}) } }
def u:counting_contains_from(filter, key, hash_index) { "Return possible membership."; if eq(hash_index, filter.hash_count) { 1 } else { index = u:bloom_hash(key, hash_index, filter.bit_count); if gt(take(filter.counters, 0, index), 0) { u:counting_contains_from(filter, key, hash_index + 1) } else { 0 } } }
def u:counting_contains(filter, key) { "Return possible membership; zero proves absence."; u:counting_contains_from(filter, key, 0) }
def u:counting_insert_many_from(filter, keys, index) { "Insert remaining occurrences."; if eq(index, tally(keys)) { filter } else { u:counting_insert_many_from(u:counting_insert(filter, take(keys, 0, index)), keys, index + 1) } }
def u:counting_build(bit_count, hash_count, keys) { "Build a counting filter including duplicates."; u:counting_insert_many_from(u:counting_new(bit_count, hash_count), keys, 0) }
def u:counting_valid(filter) { "Check shape and nonnegative integer counters."; eq(tally(filter.counters), filter.bit_count) * eq(reduce_add(eq(filter.counters, floor(filter.counters)) * (1 - lt(filter.counters, 0)), 0), filter.bit_count) }
def u:counting_max_from(counters, index, best) { "Return the largest counter."; if eq(index, tally(counters)) { best } else { value = take(counters, 0, index); u:counting_max_from(counters, index + 1, if gt(value, best) { value } else { best }) } }
