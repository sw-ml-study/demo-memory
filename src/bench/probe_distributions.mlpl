# Per-operation lookup distributions. Summary schema v1 has 12 columns:
# schema, implementation, workload, phase, capacity, count, total, mean,
# minimum, p50, p95, maximum. Phase 0 is hit and phase 1 is miss.

def u:probe_vector_from(table, keys, index, implementation, output) { "Collect inspected-slot counts for every lookup.";
  if eq(index, tally(keys)) { output } else {
    key = take(keys, 0, index);
    result = if eq(implementation, 0) { u:linear_lookup_from(table, key, 0) } else { u:robin_lookup_from(table, key, 0) };
    u:probe_vector_from(table, keys, index + 1, implementation, concat(output, result.probes))
  }
}
def u:probe_vector(table, keys, implementation) { "Return one probe count per requested lookup."; u:probe_vector_from(table, keys, 0, implementation, []) }
def u:probe_histogram_from(probes, index, histogram) { "Count probe values into one-based bins.";
  if eq(index, tally(probes)) { histogram } else {
    bin = take(probes, 0, index) - 1;
    next = scatter(histogram, bin, take(histogram, 0, bin) + 1);
    u:probe_histogram_from(probes, index + 1, next)
  }
}
def u:probe_histogram(probes, capacity) { "Return capacity bins where index zero represents one probe."; u:probe_histogram_from(probes, 0, fill([capacity], 0)) }
def u:probe_percentile_from(histogram, target, index, cumulative) { "Return a nearest-rank percentile from a probe histogram.";
  next = cumulative + take(histogram, 0, index);
  if 1 - lt(next, target) { index + 1 } else { u:probe_percentile_from(histogram, target, index + 1, next) }
}
def u:probe_min_from(probes, index, best) { "Return the minimum probe count."; if eq(index, tally(probes)) { best } else { value = take(probes, 0, index); u:probe_min_from(probes, index + 1, if lt(value, best) { value } else { best }) } }
def u:probe_stats(probes, capacity) { "Return histogram and nearest-rank summary statistics.";
  count = tally(probes);
  histogram = u:probe_histogram(probes, capacity);
  total = reduce_add(probes, 0);
  {histogram: histogram, count: count, total: total, mean: total / count, minimum: u:probe_min_from(probes, 1, take(probes, 0, 0)), p50: u:probe_percentile_from(histogram, ceil(count * 0.50), 0, 0), p95: u:probe_percentile_from(histogram, ceil(count * 0.95), 0, 0), maximum: u:max_from(probes, 0, 0)}
}
def u:probe_case(implementation, workload, phase, capacity, table, query_keys) { "Return summary and padded histogram rows for one lookup phase.";
  probes = u:probe_vector(table, query_keys, implementation);
  stats = u:probe_stats(probes, capacity);
  summary = [1, implementation, workload, phase, capacity, stats.count, stats.total, stats.mean, stats.minimum, stats.p50, stats.p95, stats.maximum];
  padded = concat(stats.histogram, fill([17 - capacity], 0));
  histogram = concat([1, implementation, workload, phase, capacity, stats.count], padded);
  {summary: summary, histogram: histogram}
}
def u:probe_implementation_rows(implementation, workload, capacity, keys, hit_keys, miss_keys) { "Return hit/miss distribution rows for one implementation.";
  table = if eq(implementation, 0) { u:linear_build(capacity, keys) } else { u:robin_build(capacity, keys) };
  hits = u:probe_case(implementation, workload, 0, capacity, table, hit_keys);
  misses = u:probe_case(implementation, workload, 1, capacity, table, miss_keys);
  {summaries: concat(reshape(hits.summary, [1, 12]), reshape(misses.summary, [1, 12]), 0), histograms: concat(reshape(hits.histogram, [1, 23]), reshape(misses.histogram, [1, 23]), 0)}
}
def u:probe_workload_rows(workload, capacity, keys, hit_keys, miss_keys) { "Return both implementation distributions on an identical workload.";
  linear = u:probe_implementation_rows(0, workload, capacity, keys, hit_keys, miss_keys);
  robin = u:probe_implementation_rows(1, workload, capacity, keys, hit_keys, miss_keys);
  {summaries: concat(linear.summaries, robin.summaries, 0), histograms: concat(linear.histograms, robin.histograms, 0)}
}
def u:standard_probe_distributions() { "Return summary and histogram matrices for all standard workloads.";
  uniform = u:probe_workload_rows(0, 11, range(5), [0, 2, 4], [20, 21, 22]);
  clustered_keys = [0, 22, 11, 1, 12, 23, 2, 13];
  clustered = u:probe_workload_rows(1, 11, clustered_keys, [0, 23, 13], [3, 99, 100]);
  rotated = u:probe_workload_rows(2, 11, rotate(clustered_keys, 3, 0), [0, 23, 13], [3, 99, 100]);
  interleaved = u:probe_workload_rows(3, 17, range(12) * 6, [0, 30, 66], [1, 67, 100]);
  {summaries: concat(concat(concat(uniform.summaries, clustered.summaries, 0), rotated.summaries, 0), interleaved.summaries, 0), histograms: concat(concat(concat(uniform.histograms, clustered.histograms, 0), rotated.histograms, 0), interleaved.histograms, 0)}
}
