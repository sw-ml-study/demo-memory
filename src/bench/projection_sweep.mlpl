def u:sweep_min3(a,b,c) { if lt(a,b){if lt(a,c){a}else{c}}else{if lt(b,c){b}else{c}} }
def u:sweep_max3(a,b,c) { if gt(a,b){if gt(a,c){a}else{c}}else{if gt(b,c){b}else{c}} }
def u:projection_sweep_row(vectors,queries,width) { prefix=if gt(width,5){5}else{width};a=u:evaluate_projected(vectors,queries,randn(11,[4,width]),prefix,1);b=u:evaluate_projected(vectors,queries,randn(29,[4,width]),prefix,1);c=u:evaluate_projected(vectors,queries,randn(47,[4,width]),prefix,1);[1,width,3,u:sweep_min3(a.hamming_recall,b.hamming_recall,c.hamming_recall),(a.hamming_recall+b.hamming_recall+c.hamming_recall)/3,u:sweep_max3(a.hamming_recall,b.hamming_recall,c.hamming_recall),u:sweep_min3(a.indexed_recall,b.indexed_recall,c.indexed_recall),(a.indexed_recall+b.indexed_recall+c.indexed_recall)/3,u:sweep_max3(a.indexed_recall,b.indexed_recall,c.indexed_recall),u:sweep_min3(a.reduction,b.reduction,c.reduction),(a.reduction+b.reduction+c.reduction)/3,u:sweep_max3(a.reduction,b.reduction,c.reduction)] }
def u:standard_projection_sweep() { vectors=[[1,0,0,0],[0.9,0.1,0,0],[0,1,0,0],[0.1,0.9,0,0],[0,0,1,0],[0,0.1,0.9,0],[0,0,0,1],[0,0,0.1,0.9]];queries=[[1,0.05,0,0],[0.05,1,0,0],[0,0,1,0.05],[0,0,0.05,1]];a=reshape(u:projection_sweep_row(vectors,queries,4),[1,12]);b=reshape(u:projection_sweep_row(vectors,queries,8),[1,12]);c=reshape(u:projection_sweep_row(vectors,queries,12),[1,12]);d=reshape(u:projection_sweep_row(vectors,queries,16),[1,12]);concat(concat(concat(a,b,0),c,0),d,0) }
