# Schema v1 rows: schema workload pattern capacity accesses hits misses
# promotions evictions final_size.

def u:lru_benchmark_row(workload, pattern, capacity, trace) { "Return one stable LRU benchmark row.";
  result = u:lru_trace(capacity, trace);
  [1, workload, pattern, capacity, result.accesses, result.hits, result.misses, result.promotions, result.evictions, result.memory.size]
}

def u:lru_standard_matrix() { "Run uniform-reuse, hot-set, scan, and bursty traces.";
  uniform = reshape(u:lru_benchmark_row(0, 0, 4, [0, 1, 2, 3, 0, 1, 2, 3]), [1, 10]);
  hot = reshape(u:lru_benchmark_row(1, 1, 3, [0, 1, 0, 1, 2, 0, 1, 3, 0, 1]), [1, 10]);
  scan = reshape(u:lru_benchmark_row(2, 2, 3, [0, 1, 2, 3, 4, 5, 6, 7]), [1, 10]);
  bursty = reshape(u:lru_benchmark_row(3, 3, 4, [0, 0, 0, 1, 1, 2, 3, 4, 4, 4, 0, 0]), [1, 10]);
  concat(concat(concat(uniform, hot, 0), scan, 0), bursty, 0)
}
